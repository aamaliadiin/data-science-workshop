# Salin file ini menjadi .env lalu isi dari kartu akses.
# File .env TIDAK ikut ter-commit (sudah diabaikan oleh .gitignore) — aman untuk password.
DB_HOST=isi_host_database
DB_PORT=5432
DB_NAME=workshop
DB_USER=isi_username
DB_PASSWORD=isi_password
